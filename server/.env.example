NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pms_user
DB_PASSWORD=pms_password
DB_NAME=project_management
DB_CONNECTION_LIMIT=10

DB_ROOT_USER=root
DB_ROOT_PASSWORD=

JWT_SECRET=replace-me-with-a-long-random-secret-value
JWT_EXPIRES_IN=1d
